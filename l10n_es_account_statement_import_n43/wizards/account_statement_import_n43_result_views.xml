<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_statement_import_n43_result_form" model="ir.ui.view">
        <field name="name">account.statement.import.n43.result.form</field>
        <field name="model">account.statement.import.n43.result</field>
        <field name="arch" type="xml">
            <form string="Import result">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        <strong>
                            Some movements were already imported and have been skipped.
                        </strong>
                        <p class="mb-0">
                            Each skipped movement is listed below with the existing
                            statement line it matches, so you can verify them. Only the
                            new movements have been imported.
                        </p>
                    </div>
                    <field name="line_ids" nolabel="1">
                        <list create="0" delete="0" edit="0">
                            <field name="date" />
                            <field name="amount" />
                            <field name="payment_ref" />
                            <field name="matched_statement_name" string="Statement" />
                            <field name="matched_line_id" string="Matching line" />
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button
                        name="action_continue"
                        string="Continue"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Close" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
